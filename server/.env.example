# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000

# MySQL connection (a dedicated account that can only use the soundpay database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=soundpay_app
DB_PASSWORD=change_me
DB_NAME=soundpay

# Cloud MySQL only (e.g. Aiven): encrypt the connection and verify the server.
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Secret used to sign payloads (HMAC-SHA256). Use a long random string.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace_with_a_long_random_string

# Mock PIN for the simulated approval step (NOT real authentication)
MOCK_PIN=1234
